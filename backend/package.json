        "axios-cookiejar-support": "^6.0.5",
        "body-parser": "^1.20.2",
        "cheerio": "^1.2.0",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.5",
        "date-fns": "^4.1.0",
        "dotenv": "^16.4.5",
        "express": "^4.19.2",
        "jsonwebtoken": "^9.0.2",
        "ldapjs": "^3.0.7",
        "mongoose": "^8.23.0",
        "mysql2": "^3.20.0",
        "node-cron": "^4.2.1",
        "node-ssh": "^13.2.1",
        "nodemailer": "^8.0.0",
        "otpauth": "^9.5.0",
        "pg": "^8.20.0",
        "tough-cookie": "^6.0.0",
        "web-push": "^3.6.7",
        "webuntis": "^2.2.1",
